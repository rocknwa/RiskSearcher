# RiskSearcher — Environment Config
# Copy to .env and fill in your values

# RPC Providers (use at least one)
ALCHEMY_API_KEY="REPLACE_WITH_ALCHEMY_API_KEY"
INFURA_API_KEY="REPLACE_WITH_INFURA_API_KEY"

# Etherscan — for verified source code fetch (primary analysis layer)
# Free tier at https://etherscan.io/myapikey — 5 req/s is plenty
ETHERSCAN_API_KEY="REPLACE_WITH_ETHERSCAN_API_KEY"

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
# Options: llama3, deepseek-coder, mistral, codellama
OLLAMA_MODEL=gemma2:2b

# Tool identity shown in output
TOOL_NAME=RiskSearcher

# Score threshold: above this = THREAT
THREAT_THRESHOLD=30
ANTHROPIC_API_KEY="REPLACE_WITH_ANTHROPIC_API_KEY"
AGENTROUTER_API_KEY="REPLACE_WITH_AGENTROUTER_API_KEY"

# The Graph — Subgraph Studio Gateway key, for live Uniswap V3 liquidity evidence
# https://thegraph.com/studio
GRAPH_API_KEY="REPLACE_WITH_GRAPH_API_KEY"

# Circle Arc — Developer-Controlled Wallets treasury integration
# https://console.circle.com — see rpc/arc_provider.py docstring for full setup steps
CIRCLE_API_KEY="REPLACE_WITH_CIRCLE_API_KEY"
CIRCLE_ENTITY_SECRET="REPLACE_WITH_64_CHAR_HEX_ENTITY_SECRET"
# Optional — auto-created and cached in data/arc_state.json if left blank
CIRCLE_WALLET_SET_ID=""
# ARC-TESTNET by default. Set to ARC (plus real mainnet CIRCLE_API_KEY /
# CIRCLE_ENTITY_SECRET / CIRCLE_WALLET_SET_ID) to point every wallet
# creation, lookup, and transfer at Arc mainnet with no code change.
ARC_BLOCKCHAIN="ARC-TESTNET"

# World ID — Selfie Check verification (free-trial Sybil defense).
# From developer.world.org, after RP registration (World ID 4.0):
# App ID -> WORLD_APP_ID (also needed client-side, see interface/.env.example)
# RP ID  -> WORLD_ID_RP_ID (this value; the signing_key itself is a
# Vercel-only secret, never set here - see interface/.env.example)
WORLD_ID_RP_ID="REPLACE_WITH_WORLD_RP_ID"

# Scan history — Google Cloud Firestore (permanent free tier, not a trial).
# Paste the ENTIRE contents of your service account JSON key as one string.
# See db/scan_history_store.py docstring for the full setup steps.
FIRESTORE_CREDENTIALS_JSON="REPLACE_WITH_YOUR_SERVICE_ACCOUNT_JSON"
# A real Arc Testnet address you control — subscription payments are sent here
ARC_TREASURY_ADDRESS="REPLACE_WITH_YOUR_ARC_TESTNET_TREASURY_ADDRESS"
