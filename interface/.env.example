# VITE_API_BASE_URL: Base URL of the RiskSearcher backend API (FastAPI/persistent server).
# e.g. http://localhost:8000 for local dev, or your deployed backend URL.
VITE_API_BASE_URL="http://localhost:8000"

# Add any client-safe public keys here (e.g. WalletConnect Project ID, Circle publishable key).
# Never put server-side secrets (LLM API keys, Circle secret keys) in a VITE_-prefixed var —
# anything prefixed VITE_ is bundled into client-side JS and publicly readable.
